# Shared pairing secret for local and hosted modes. Use at least 20 random bytes; never commit the actual value.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JOIN_CODE=
# Optional: override the provisioned administrator device ID. Keep this server-side only.
ADMIN_DEVICE_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Connect a PRIVATE Vercel Blob store and supply its read/write token.
BLOB_READ_WRITE_TOKEN=
# Canonical HTTPS origin of the hosted deployment; required for strict production Origin checks.
APP_ORIGIN=https://your-domain.example
# Long random secret for the scheduled file-cleanup endpoint.
CRON_SECRET=

# Optional local LAN mode behind a trusted HTTPS reverse proxy (for example, Caddy).
# Set HOST=127.0.0.1, PUBLIC_ORIGIN to the external HTTPS origin, and COOKIE_SECURE=1.
HOST=127.0.0.1
PUBLIC_ORIGIN=
COOKIE_SECURE=0
